# PULSE configuration — copy to .env and adjust (or export directly).
# Every value has a safe local default; nothing here is required for dev.

# Flask session secret. REQUIRED in production; generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PULSE_SECRET_KEY=

# SQLite database location (default: <repo>/data/ledger.db)
PULSE_DB_PATH=

# Bind address / port for the dev server (python3 web/app.py).
# Keep 127.0.0.1 unless you understand the exposure: PULSE is a
# single-user app with NO authentication layer — never bind it to a
# public interface without a reverse proxy providing auth.
PULSE_HOST=127.0.0.1
PULSE_PORT=5001

# Werkzeug debug mode (interactive debugger = code execution). Dev only.
PULSE_DEBUG=0

# Max statement upload size in MB.
PULSE_MAX_UPLOAD_MB=16

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
PULSE_LOG_LEVEL=INFO
